generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  orgSlug   String   @unique
  users     User[]
  students  Student[]
  advisors  Advisor[]
  programs  Program[]
  colleges  College[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String?
  image          String?
  role           UserRole      @default(STUDENT)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  student        Student?
  advisor        Advisor?
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum UserRole {
  STUDENT
  ADVISOR
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Student {
  id                    String                         @id @default(cuid())
  userId                String                         @unique
  user                  User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId        String
  organization          Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName             String?
  lastName              String?
  email                 String                         @unique
  classYear             String?
  college               String?
  major                 String?
  minor                 String?
  needsFunding          Boolean                        @default(false)
  profileSummary        String?
  skillGoals            String?
  cannotDoConstraints   String?
  advisors              AdvisorStudent[]
  opportunityInterests  StudentOpportunityInterest[]
  keywords              StudentKeyword[]
  statuses              StudentStatus[]
  chatThreads           ChatThread[]
  savedPrograms         StudentSavedProgram[]
  hiddenPrograms        StudentHiddenProgram[]
  recommendations       StudentProgramRecommendation[]
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
}

model Advisor {
  id             String           @id @default(cuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String?
  lastName       String?
  email          String           @unique
  department     String?
  roleTitle      String?
  students       AdvisorStudent[]
  chatThreads    ChatThread[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model AdvisorStudent {
  id               String   @id @default(cuid())
  advisorId        String
  advisor          Advisor  @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationshipType String   @default("primary")
  assignedAt       DateTime @default(now())

  @@unique([advisorId, studentId])
}

model Program {
  id                    String                         @id @default(cuid())
  organizationId        String
  organization          Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title                 String
  slug                  String
  sourceUrl             String
  website               String?
  contact               String?
  descriptionText       String
  timeline              String?
  durationLabel         String?
  deadlineDate          DateTime?
  creditAvailable       Boolean                        @default(false)
  workStudyOffered      Boolean                        @default(false)
  financialAidAvailable Boolean                        @default(false)
  gpaMinimumRequired    Boolean                        @default(false)
  gpaRequirement        String?
  periods               String[]
  fundingTypes          String[]
  keywords              String[]
  imageUrl              String?
  featured              Boolean                        @default(false)
  isActive              Boolean                        @default(true)
  eligibleClassYears    ProgramEligibleClassYear[]
  colleges              ProgramCollege[]
  opportunityTypes      ProgramOpportunityType[]
  sdgTags               ProgramSdgTag[]
  requirements          ProgramRequirement[]
  chatThreads           ChatThreadProgram[]
  savedByStudents       StudentSavedProgram[]
  hiddenByStudents      StudentHiddenProgram[]
  recommendations       StudentProgramRecommendation[]
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@unique([organizationId, sourceUrl])
  @@unique([organizationId, slug])
}

model ClassYear {
  id       String                     @id @default(cuid())
  name     String                     @unique
  programs ProgramEligibleClassYear[]
}

model ProgramEligibleClassYear {
  id          String    @id @default(cuid())
  programId   String
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  classYearId String
  classYear   ClassYear @relation(fields: [classYearId], references: [id], onDelete: Cascade)

  @@unique([programId, classYearId])
}

model College {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  programs       ProgramCollege[]

  @@unique([organizationId, name])
}

model ProgramCollege {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  collegeId String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([programId, collegeId])
}

model OpportunityType {
  id       String                       @id @default(cuid())
  name     String                       @unique
  programs ProgramOpportunityType[]
  students StudentOpportunityInterest[]
}

model ProgramOpportunityType {
  id                String          @id @default(cuid())
  programId         String
  program           Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  opportunityTypeId String
  opportunityType   OpportunityType @relation(fields: [opportunityTypeId], references: [id], onDelete: Cascade)

  @@unique([programId, opportunityTypeId])
}

model SdgTag {
  id       String              @id @default(cuid())
  name     String              @unique
  programs ProgramSdgTag[]
}

model ProgramSdgTag {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  sdgTagId  String
  sdgTag    SdgTag  @relation(fields: [sdgTagId], references: [id], onDelete: Cascade)

  @@unique([programId, sdgTagId])
}

model ProgramRequirement {
  id               String  @id @default(cuid())
  programId        String
  program          Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  requirementType  String
  requirementValue String
}

model StudentOpportunityInterest {
  id                String          @id @default(cuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunityTypeId String
  opportunityType   OpportunityType @relation(fields: [opportunityTypeId], references: [id], onDelete: Cascade)
  interestWeight    Float           @default(1.0)

  @@unique([studentId, opportunityTypeId])
}

model StudentKeyword {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  keyword   String
  weight    Float   @default(1.0)

  @@unique([studentId, keyword])
}

model StudentStatus {
  id         String  @id @default(cuid())
  studentId  String
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  statusName String

  @@unique([studentId, statusName])
}

model ChatThread {
  id        String              @id @default(cuid())
  studentId String?
  student   Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)
  advisorId String?
  advisor   Advisor?            @relation(fields: [advisorId], references: [id], onDelete: SetNull)
  title     String?
  messages  ChatMessage[]
  programs  ChatThreadProgram[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model ChatMessage {
  id           String     @id @default(cuid())
  chatThreadId String
  chatThread   ChatThread @relation(fields: [chatThreadId], references: [id], onDelete: Cascade)
  role         ChatRole
  content      String
  createdAt    DateTime   @default(now())
}

model ChatThreadProgram {
  id           String     @id @default(cuid())
  chatThreadId String
  chatThread   ChatThread @relation(fields: [chatThreadId], references: [id], onDelete: Cascade)
  programId    String
  program      Program    @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([chatThreadId, programId])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model StudentSavedProgram {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())

  @@unique([studentId, programId])
}

model StudentHiddenProgram {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  hiddenAt  DateTime @default(now())

  @@unique([studentId, programId])
}

model StudentProgramRecommendation {
  id                    String   @id @default(cuid())
  studentId             String
  student               Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId             String
  program               Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  eligibilityPassed     Boolean  @default(true)
  eligibilityReason     String?
  contentSimilarityScore Float?
  finalScore            Float?
  explanation           String?
  generatedAt           DateTime @default(now())

  @@index([studentId])
  @@index([programId])
}

